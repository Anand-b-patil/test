    METHODS deriveUOM FOR DETERMINE ON MODIFY
      IMPORTING keys FOR SampleRequest~deriveUOM.

    METHODS validateMaterial FOR VALIDATE ON SAVE
      IMPORTING keys FOR SampleRequest~validateMaterial.

    METHODS validateCustomer FOR VALIDATE ON SAVE
      IMPORTING keys FOR SampleRequest~validateCustomer.

    METHODS validateQuantity FOR VALIDATE ON SAVE
      IMPORTING keys FOR SampleRequest~validateQuantity.

    METHODS Validate FOR MODIFY
      IMPORTING keys FOR ACTION SampleRequest~Validate RESULT result.

    METHODS Approve FOR MODIFY
      IMPORTING keys FOR ACTION SampleRequest~Approve RESULT result.

    METHODS Reject FOR MODIFY
      IMPORTING keys FOR ACTION SampleRequest~Reject RESULT result.

ENDCLASS.


CLASS lhc_SampleRequest IMPLEMENTATION.

  METHOD get_instance_features.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( ReqStatus )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    result = VALUE #( FOR ls_request IN lt_requests
      ( %tky = ls_request-%tky

        %features-%action-Validate =
          COND #( WHEN ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_new
                  THEN if_abap_behv=>fc-o-enabled ELSE if_abap_behv=>fc-o-disabled )

        %features-%action-Approve =
          COND #( WHEN ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_validated
                  THEN if_abap_behv=>fc-o-enabled ELSE if_abap_behv=>fc-o-disabled )

        %features-%action-Reject =
          COND #( WHEN ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_new
                       OR ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_validated
                  THEN if_abap_behv=>fc-o-enabled ELSE if_abap_behv=>fc-o-disabled )

        %features-%update =
          COND #( WHEN ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_new
                  THEN if_abap_behv=>fc-o-enabled ELSE if_abap_behv=>fc-o-disabled )

        %features-%delete =
          COND #( WHEN ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_new
                  THEN if_abap_behv=>fc-o-enabled ELSE if_abap_behv=>fc-o-disabled )
      ) ).
  ENDMETHOD.


  METHOD setInitialValues.
    DATA lt_update TYPE TABLE FOR UPDATE ZI_SampleRequest.

    SELECT SINGLE MAX( request_no ) FROM zsdt_sample_req INTO @DATA(lv_max_char).

    DATA(lv_counter) = COND i( WHEN lv_max_char IS NOT INITIAL
                                THEN lv_max_char+3(7)
                                ELSE 0 ).

    LOOP AT keys INTO DATA(ls_key).
      lv_counter += 1.

      APPEND VALUE #(
        %tky                = ls_key-%tky
        RequestNo           = |{ zcl_sdt_sample_util=>mc_req_prefix }{ lv_counter WIDTH = 7 ALIGN = RIGHT PAD = '0' }|
        %control-RequestNo  = if_abap_behv=>mk-on
        ReqStatus           = zcl_sdt_sample_util=>mc_status_new
        %control-ReqStatus  = if_abap_behv=>mk-on
        ReqDate             = cl_abap_context_info=>get_system_date( )
        %control-ReqDate    = if_abap_behv=>mk-on
      ) TO lt_update.
    ENDLOOP.

    MODIFY ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        UPDATE FIELDS ( RequestNo ReqStatus ReqDate )
        WITH lt_update.
  ENDMETHOD.


  METHOD deriveUOM.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( Material Uom )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    DATA lt_update TYPE TABLE FOR UPDATE ZI_SampleRequest.

    LOOP AT lt_requests INTO DATA(ls_request)
         WHERE Uom IS INITIAL AND Material IS NOT INITIAL.

      SELECT SINGLE base_unit
        FROM I_Product
        WHERE product = @ls_request-Material
        INTO @DATA(lv_base_unit).

      IF sy-subrc = 0.
        APPEND VALUE #(
          %tky             = ls_request-%tky
          Uom              = lv_base_unit
          %control-Uom     = if_abap_behv=>mk-on
        ) TO lt_update.
      ENDIF.
    ENDLOOP.

    IF lt_update IS NOT INITIAL.
      MODIFY ENTITIES OF ZI_SampleRequest IN LOCAL MODE
        ENTITY SampleRequest
          UPDATE FIELDS ( Uom )
          WITH lt_update.
    ENDIF.
  ENDMETHOD.


  METHOD validateMaterial.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( Material Plant )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    LOOP AT lt_requests INTO DATA(ls_request).
      APPEND VALUE #( %tky = ls_request-%tky ) TO reported-samplerequest.

      IF ls_request-Material IS INITIAL.
        CONTINUE.
      ENDIF.

      SELECT SINGLE product FROM I_Product
        WHERE product = @ls_request-Material
        INTO @DATA(lv_product).

      IF sy-subrc <> 0.
        APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_request-%tky
                         %msg = NEW zcx_sdt_sample_msg(
                                    textid   = zcx_sdt_sample_msg=>material_not_found
                                    material = ls_request-Material ) )
               TO reported-samplerequest.
        CONTINUE.
      ENDIF.

      IF ls_request-Plant IS NOT INITIAL.
        SELECT SINGLE product FROM I_ProductPlantBasic
          WHERE product = @ls_request-Material
            AND plant   = @ls_request-Plant
          INTO @DATA(lv_product_plant).

        IF sy-subrc <> 0.
          APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
          APPEND VALUE #( %tky = ls_request-%tky
                           %msg = NEW zcx_sdt_sample_msg(
                                      textid   = zcx_sdt_sample_msg=>material_not_extended
                                      material = ls_request-Material
                                      plant    = ls_request-Plant ) )
                 TO reported-samplerequest.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD validateCustomer.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( Customer )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    LOOP AT lt_requests INTO DATA(ls_request).
      APPEND VALUE #( %tky = ls_request-%tky ) TO reported-samplerequest.

      IF ls_request-Customer IS INITIAL.
        CONTINUE.
      ENDIF.

      SELECT SINGLE kunnr, sperr FROM kna1
        WHERE kunnr = @ls_request-Customer
        INTO @DATA(ls_kna1).

      IF sy-subrc <> 0.
        APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_request-%tky
                         %msg = NEW zcx_sdt_sample_msg(
                                    textid   = zcx_sdt_sample_msg=>customer_not_found
                                    customer = ls_request-Customer ) )
               TO reported-samplerequest.
        CONTINUE.
      ENDIF.

      IF ls_kna1-sperr = abap_true.
        APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_request-%tky
                         %msg = NEW zcx_sdt_sample_msg(
                                    textid   = zcx_sdt_sample_msg=>customer_blocked
                                    customer = ls_request-Customer ) )
               TO reported-samplerequest.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD validateQuantity.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( Quantity )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    DATA(lv_max_qty) = zcl_sdt_sample_util=>get_max_sample_qty( ).

    LOOP AT lt_requests INTO DATA(ls_request).
      APPEND VALUE #( %tky = ls_request-%tky ) TO reported-samplerequest.

      IF ls_request-Quantity <= 0.
        APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_request-%tky
                         %msg = NEW zcx_sdt_sample_msg( textid = zcx_sdt_sample_msg=>quantity_invalid ) )
               TO reported-samplerequest.
        CONTINUE.
      ENDIF.

      IF ls_request-Quantity > lv_max_qty.
        APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_request-%tky
                         %msg = NEW zcx_sdt_sample_msg(
                                    textid   = zcx_sdt_sample_msg=>quantity_exceeded
                                    quantity = |{ ls_request-Quantity }|
                                    max_qty  = |{ lv_max_qty }| ) )
               TO reported-samplerequest.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD Validate.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( Customer )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    DATA lt_update TYPE TABLE FOR UPDATE ZI_SampleRequest.

    LOOP AT lt_requests INTO DATA(ls_request).
      IF zcl_sdt_sample_util=>is_monthly_cap_hit( ls_request-Customer ).
        APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_request-%tky
                         %msg = NEW zcx_sdt_sample_msg(
                                    textid   = zcx_sdt_sample_msg=>monthly_cap_exceeded
                                    customer = ls_request-Customer ) )
               TO reported-samplerequest.
        CONTINUE.
      ENDIF.

      APPEND VALUE #(
        %tky                = ls_request-%tky
        ReqStatus           = zcl_sdt_sample_util=>mc_status_validated
        %control-ReqStatus  = if_abap_behv=>mk-on
      ) TO lt_update.
    ENDLOOP.

    IF lt_update IS NOT INITIAL.
      MODIFY ENTITIES OF ZI_SampleRequest IN LOCAL MODE
        ENTITY SampleRequest
          UPDATE FIELDS ( ReqStatus )
          WITH lt_update
        FAILED failed
        REPORTED reported.
    ENDIF.

    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_result).

    result = VALUE #( FOR ls_result IN lt_result
                       ( %tky = ls_result-%tky %param = ls_result ) ).
  ENDMETHOD.


  METHOD Approve.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( ReqStatus )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    DATA lt_update TYPE TABLE FOR UPDATE ZI_SampleRequest.

    LOOP AT lt_requests INTO DATA(ls_request).
      IF ls_request-ReqStatus <> zcl_sdt_sample_util=>mc_status_validated.
        APPEND VALUE #( %tky = ls_request-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_request-%tky
                         %msg = NEW zcx_sdt_sample_msg( textid = zcx_sdt_sample_msg=>approval_error ) )
               TO reported-samplerequest.
        CONTINUE.
      ENDIF.

      APPEND VALUE #(
        %tky                  = ls_request-%tky
        ReqStatus             = zcl_sdt_sample_util=>mc_status_approved
        %control-ReqStatus    = if_abap_behv=>mk-on
        ApprovedBy            = cl_abap_context_info=>get_user_technical_name( )
        %control-ApprovedBy   = if_abap_behv=>mk-on
        ApprovedOn            = cl_abap_context_info=>get_system_date( )
        %control-ApprovedOn   = if_abap_behv=>mk-on
      ) TO lt_update.
    ENDLOOP.

    IF lt_update IS NOT INITIAL.
      MODIFY ENTITIES OF ZI_SampleRequest IN LOCAL MODE
        ENTITY SampleRequest
          UPDATE FIELDS ( ReqStatus ApprovedBy ApprovedOn )
          WITH lt_update
        FAILED failed
        REPORTED reported.
    ENDIF.

    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_result).

    result = VALUE #( FOR ls_result IN lt_result
                       ( %tky = ls_result-%tky %param = ls_result ) ).
  ENDMETHOD.


  METHOD Reject.
    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        FIELDS ( ReqStatus )
        WITH CORRESPONDING #( keys )
      RESULT DATA(lt_requests).

    DATA lt_update TYPE TABLE FOR UPDATE ZI_SampleRequest.

    LOOP AT keys INTO DATA(ls_key).
      READ TABLE lt_requests INTO DATA(ls_request) WITH KEY %tky = ls_key-%tky.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      IF ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_approved
      OR ls_request-ReqStatus = zcl_sdt_sample_util=>mc_status_rejected.
        APPEND VALUE #( %tky = ls_key-%tky ) TO failed-samplerequest.
        APPEND VALUE #( %tky = ls_key-%tky
                         %msg = NEW zcx_sdt_sample_msg( textid = zcx_sdt_sample_msg=>reject_error ) )
               TO reported-samplerequest.
        CONTINUE.
      ENDIF.

      APPEND VALUE #(
        %tky                    = ls_key-%tky
        ReqStatus               = zcl_sdt_sample_util=>mc_status_rejected
        %control-ReqStatus      = if_abap_behv=>mk-on
        RejectReason            = ls_key-%param-RejectReason
        %control-RejectReason   = if_abap_behv=>mk-on
      ) TO lt_update.
    ENDLOOP.

    IF lt_update IS NOT INITIAL.
      MODIFY ENTITIES OF ZI_SampleRequest IN LOCAL MODE
        ENTITY SampleRequest
          UPDATE FIELDS ( ReqStatus RejectReason )
          WITH lt_update
        FAILED failed
        REPORTED reported.
    ENDIF.

    READ ENTITIES OF ZI_SampleRequest IN LOCAL MODE
      ENTITY SampleRequest
        ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(lt_result).

    result = VALUE #( FOR ls_result IN lt_result
                       ( %tky = ls_result-%tky %param = ls_result ) ).
  ENDMETHOD.

ENDCLASS.
```

### Concept Explanations
- **`READ ENTITIES ... IN LOCAL MODE`** — the RAP-approved way to re-read instance data inside a handler; "local mode" means it reads the in-transaction buffer (including not-yet-saved changes), not a fresh DB round-trip.
- **`%tky`** — the framework-generated technical key structure component (wraps the semantic/technical key fields) used to correlate `keys`, `failed`, `reported`, and `mapped` entries back to the same instance.
- **`%control-<field> = if_abap_behv=>mk-on`** — mandatory whenever you set a field value via `MODIFY ENTITIES`; without it, RAP ignores the value (treats it as "field not touched").
- **`FAILED` / `REPORTED`** — standard RAP output parameters: `FAILED` marks which instances didn't process; `REPORTED` carries the actual messages (built from our exception class) shown to the user.
- **Action's own `RESULT`** — every action must return the updated instance(s) via `%param`, which is what lets Fiori Elements refresh the row's status/color immediately after Approve/Reject/Validate without a page reload.
- **Utility Class reuse** — note `zcl_sdt_sample_util=>mc_status_*` constants and `is_monthly_cap_hit`/`get_max_sample_qty` calls are used everywhere status logic or limits are checked — never duplicated as raw literals or repeated SELECTs.

### Testing Steps (via ADT's built-in RAP Business Object test tool)
1. Right-click `ZC_SampleRequest` behavior definition → **Run As → Business Object Test Class** (or use the service binding preview once Step 10 is built — recommended for full end-to-end testing).
2. Create a new instance with a known invalid material → expect `validateMaterial` to block save with message 001.
3. Create a valid instance → Save → confirm `RequestNo` auto-generated as `SDR0000001`, `ReqStatus` = `N`.
4. Call `Validate` action → confirm status becomes `V` (or blocked with message 009 if you've created 5+ requests this month for that customer).
5. Call `Approve` on a `V` record → confirm status becomes `A`, `ApprovedBy`/`ApprovedOn` populated.
6. Try `Approve` again → expect message 007 (Approval Error), since status is now `A` not `V`.
7. Call `Reject` on an `N` record with a reason → confirm status becomes `R`, `RejectReason` stored.

### Expected Output
All scenarios behave exactly as above; class activates with zero syntax errors once all Step 1–7 objects are active.

### Common Errors & Fixes

| Error | Cause | Fix |
|---|---|---|
| `Field REQUEST_NO cannot be changed, it is read-only` | Trying to set `RequestNo` from outside `setInitialValues` | Only the determination may write it — confirm no other code path touches it |
| `Exception CX_SY_ITAB_LINE_NOT_FOUND` in Reject | `READ TABLE ... WITH KEY %tky` fails silently caught, but if removed causes dump | Keep the `IF sy-subrc <> 0. CONTINUE. ENDIF.` guard |
| Monthly cap never triggers | Test data's `req_date` outside current month, or all prior requests have `req_status = 'R'` (excluded by design) | Confirm test data dates fall within the current calendar month |
| `TYPE_CONFLICT` when calling `get_max_sample_qty` in `validateQuantity` | Mismatched quan type precision between behavior structure and utility method return | Utility method returns `p length 8 decimals 3`, matching table's `quan(13,3)` at value-level; ensure no truncation warning ignored |

