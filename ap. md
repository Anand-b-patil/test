@EndUserText.label: 'Sample Request - Root View'
@Metadata.allowExtensions: true
@ObjectModel.semanticKey: ['RequestNo']
@ObjectModel.representativeKey: 'RequestNo'
@Search.searchable: true
define root view entity ZI_SampleRequest
  as select from zsdt_sample_req
  association [0..1] to I_Customer as _Customer on  $projection.Customer = _Customer.Customer
  association [0..1] to I_Product  as _Product  on  $projection.Material = _Product.Product
  association [0..1] to I_Plant    as _Plant    on  $projection.Plant    = _Plant.Plant
{
      key request_uuid                                as RequestUUID,
          request_no                                   as RequestNo,

      @Search.defaultSearchElement: true
      @ObjectModel.text.element: ['CustomerName']
          customer                                     as Customer,

      @Search.defaultSearchElement: true
      // NOTE: Description text element intentionally omitted here.
      // I_Product's description field name must be confirmed in your
      // system (F2 / code completion in ADT) before adding
      // @ObjectModel.text.element for Material - not assumed per
      // project rule "never assume fields".
          material                                     as Material,

          plant                                         as Plant,

      @Semantics.quantity.unitOfMeasure: 'Uom'
          quantity                                      as Quantity,
          uom                                            as Uom,

          req_date                                       as ReqDate,
          req_status                                      as ReqStatus,

          // Computed criticality: drives status color in Fiori list/object page.
          // 0 = Neutral (Grey) - New
          // 1 = Negative (Red) - Rejected
          // 2 = Critical (Yellow) - Validated
          // 3 = Positive (Green) - Approved
          case req_status
            when 'A' then '3'
            when 'R' then '1'
            when 'V' then '2'
            else '0'
          end                                              as Criticality,

          reject_reason                                     as RejectReason,
          approved_by                                        as ApprovedBy,
          approved_on                                         as ApprovedOn,

      @Semantics.user.createdBy: true
          created_by                                          as CreatedBy,

      @Semantics.systemDateTime.createdAt: true
          created_at                                           as CreatedAt,

      @Semantics.user.lastChangedBy: true
          last_changed_by                                       as LastChangedBy,

      @Semantics.systemDateTime.lastChangedAt: true
          last_changed_at                                        as LastChangedAt,

      @Semantics.systemDateTime.localInstanceLastChangedAt: true
          local_last_changed_at                                   as LocalLastChangedAt,

          _Customer.CustomerName                                   as CustomerName,

          /* Associations exposed for navigation & value helps */
          _Customer,
          _Product,
          _Plant
}
```

### Annotation Explanations
- **`@AccessControl.authorizationCheck: #CHECK`** — mandates that an authorization check (DCL or behavior-level auth) is enforced before data is returned; `#NOT_REQUIRED` would silently disable this, which is unacceptable for a workflow with Approve/Reject.
- **`@Metadata.allowExtensions: true`** — permits a Metadata Extension (Step 6) to attach UI annotations without modifying this view.
- **`@ObjectModel.semanticKey: ['RequestNo']`** — tells Fiori/OData that `RequestNo`, not the technical UUID, is the field users identify a record by (search, deep links).
- **`@ObjectModel.representativeKey`** — the single field shown when the app needs one label for the whole entity (e.g., message texts, breadcrumbs).
- **`@Search.searchable` / `@Search.defaultSearchElement`** — enables the Fiori Elements search bar; `defaultSearchElement` marks which fields that free-text search actually scans (Customer, Material).
- **`@Semantics.quantity.unitOfMeasure: 'Uom'`** — links `Quantity` to `Uom` so Fiori/ALV render "50.000 KG" correctly with proper decimal handling, instead of a bare number.
- **`@ObjectModel.text.element: ['CustomerName']`** — tells consumers that `CustomerName` is the human-readable text for the `Customer` code field, enabling automatic "code + description" rendering in value helps.
- **`@Semantics.user.createdBy` / `.systemDateTime.createdAt` / `.lastChangedBy` / `.lastChangedAt`** — these are what let RAP **auto-populate** these fields on Create/Update without any code in the Behavior Implementation.
- **`@Semantics.systemDateTime.localInstanceLastChangedAt`** — marks the field eligible to be declared `etag master` in the Behavior Definition.
- **`Criticality` computed column** — a `CASE` expression, not a persisted field; consumed later by `@UI.lineItem: [{ criticality: 'Criticality' }]` in the Metadata Extension for color-coded status.

