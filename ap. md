INITIALIZATION.
  DATA: lt_list TYPE vrm_values,
        ls_list LIKE LINE OF lt_list.

  ls_list-key = ''.
  ls_list-text = 'All Statuses'.
  APPEND ls_list TO lt_list.
  ls_list-key = zcl_sdt_sample_util=>mc_status_new.
  ls_list-text = 'New'.
  APPEND ls_list TO lt_list.
  ls_list-key = zcl_sdt_sample_util=>mc_status_validated.
  ls_list-text = 'Validated'.
  APPEND ls_list TO lt_list.
  ls_list-key = zcl_sdt_sample_util=>mc_status_approved.
  ls_list-text = 'Approved'.
  APPEND ls_list TO lt_list.
  ls_list-key = zcl_sdt_sample_util=>mc_status_rejected.
  ls_list-text = 'Rejected'.
  APPEND ls_list TO lt_list.

  CALL FUNCTION 'VRM_SET_VALUES'
    EXPORTING
      id     = 'P_STATUS'
      values = lt_list.

START-OF-SELECTION.
  PERFORM read_data.
  PERFORM display_alv.

FORM read_data.
  DATA: lr_status TYPE RANGE OF zsdt_sample_req-req_status.

  IF p_status IS NOT INITIAL.
    lr_status = VALUE #( ( sign = 'I' option = 'EQ' low = p_status ) ).
  ENDIF.

  IF p_open = abap_true.
    lr_status = VALUE #( BASE lr_status
      ( sign = 'E' option = 'EQ' low = zcl_sdt_sample_util=>mc_status_approved )
      ( sign = 'E' option = 'EQ' low = zcl_sdt_sample_util=>mc_status_rejected ) ).
  ENDIF.

  SELECT a~request_uuid, a~request_no, a~customer, c~name1,
         a~material, b~maktx, a~plant, a~quantity, a~uom,
         a~req_date, a~req_status, a~reject_reason,
         a~approved_by, a~approved_on
    FROM zsdt_sample_req AS a
    LEFT JOIN makt AS b
      ON b~matnr = a~material AND b~spras = @sy-langu
    LEFT JOIN kna1 AS c
      ON c~kunnr = a~customer
    WHERE a~customer   IN @s_kunnr
      AND a~material   IN @s_matnr
      AND a~req_date   IN @s_rdate
      AND a~req_status IN @lr_status
    INTO CORRESPONDING FIELDS OF TABLE @gt_display.

  LOOP AT gt_display ASSIGNING FIELD-SYMBOL(<ls_display>).
    <ls_display>-status_text = zcl_sdt_sample_util=>get_status_text( <ls_display>-req_status ).

    DATA(lv_color) = SWITCH lvc_col( <ls_display>-req_status
      WHEN zcl_sdt_sample_util=>mc_status_approved  THEN cl_gui_resources=>list_color_positive
      WHEN zcl_sdt_sample_util=>mc_status_rejected  THEN cl_gui_resources=>list_color_negative
      WHEN zcl_sdt_sample_util=>mc_status_validated THEN cl_gui_resources=>list_color_important
      ELSE cl_gui_resources=>list_color_total ).

    APPEND VALUE #( fname = 'REQ_STATUS' color-col = lv_color color-int = 0 color-inv = 0 )
      TO <ls_display>-cellcolor.
  ENDLOOP.
ENDFORM.

FORM display_alv.
  TRY.
      cl_salv_table=>factory(
        IMPORTING r_salv_table = go_table
        CHANGING  t_table      = gt_display ).
    CATCH cx_salv_msg.
      MESSAGE 'ALV could not be created' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.

  go_table->get_functions( )->set_all( abap_true ).

  DATA(lo_columns) = go_table->get_columns( ).
  lo_columns->set_color_column( 'CELLCOLOR' ).
  lo_columns->get_column( 'REQUEST_UUID' )->set_visible( abap_false ).
  lo_columns->get_column( 'CELLCOLOR' )->set_technical( abap_true ).

  TRY.
      lo_columns->get_column( 'REQUEST_NO' )->set_short_text( 'Req. No' ).
      lo_columns->get_column( 'NAME1' )->set_short_text( 'Customer Name' ).
      lo_columns->get_column( 'MAKTX' )->set_short_text( 'Material Desc' ).
      lo_columns->get_column( 'STATUS_TEXT' )->set_short_text( 'Status' ).
      CAST cl_salv_column_table( lo_columns->get_column( 'REQUEST_NO' )
        )->set_cell_type( if_salv_c_cell_type=>hotspot ).
    CATCH cx_salv_not_found.
  ENDTRY.

  DATA(lo_sorts) = go_table->get_sorts( ).
  TRY.
      lo_sorts->add_sort( 'CUSTOMER' ).
      lo_sorts->add_sort( 'REQ_STATUS' ).
    CATCH cx_salv_existing cx_salv_data_error cx_salv_not_found.
  ENDTRY.

  DATA(lo_aggregations) = go_table->get_aggregations( ).
  TRY.
      lo_aggregations->add_aggregation( 'QUANTITY' ).
    CATCH cx_salv_existing cx_salv_data_error cx_salv_not_found.
  ENDTRY.

  DATA(lo_display) = go_table->get_display_settings( ).
  lo_display->set_list_header( 'Material Sample Dispatch Requests' ).
  lo_display->set_striped_pattern( abap_true ).

  DATA(lo_events) = go_table->get_event( ).
  DATA(lo_handler) = NEW lcl_handler( ).
  SET HANDLER lo_handler->on_link_click FOR lo_events.

  go_table->display( ).
ENDFORM.
